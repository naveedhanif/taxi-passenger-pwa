{
  "rewrites": [
    {
      "source": "/:slug([a-zA-Z0-9-]+)",
      "destination": "/api/page?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "dist/index.html"
    }
  }
}